{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryResponse",
  "type": "object",
  "properties": {
    "database_bytes": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "dropped_writes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "newest_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint128",
      "minimum": 0
    },
    "oldest_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint128",
      "minimum": 0
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HistoryPoint"
      }
    },
    "retained_cuts": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "oldest_at_ms",
    "newest_at_ms",
    "retained_cuts",
    "database_bytes",
    "dropped_writes",
    "points"
  ],
  "$defs": {
    "BackendMetricsCoverage": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "EngineThroughputSample": {
      "description": "Physically de-duplicated per-request output-token throughput from the newest\nsuccessful Prometheus TPOT interval across configured engines. The value is the\ninverse mean `request_time_per_output_token_seconds`; speculative accepted tokens\nare already reflected in that shorter output-token time and are never double-counted.\nOne physical `/metrics` endpoint contributes once even when several logical routes\npoint at it.",
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/BackendMetricsCoverage"
        },
        "generated_tokens_per_sec": {
          "type": "number",
          "format": "double"
        },
        "measured_sources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sampled_at_ms": {
          "type": "integer",
          "format": "uint128",
          "minimum": 0
        },
        "total_sources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "generated_tokens_per_sec",
        "sampled_at_ms",
        "measured_sources",
        "total_sources",
        "coverage"
      ]
    },
    "HistoryPoint": {
      "type": "object",
      "properties": {
        "at_ms": {
          "type": "integer",
          "format": "uint128",
          "minimum": 0
        },
        "cursors": {
          "$ref": "#/$defs/SeqCursors"
        },
        "cut_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "engine_throughput": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineThroughputSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "instant": {
          "$ref": "#/$defs/InstantMetricSample"
        }
      },
      "required": [
        "cut_id",
        "at_ms",
        "cursors",
        "instant"
      ]
    },
    "InstantMetricQuality": {
      "description": "Data quality for one instantaneous metric value. Percentiles are still emitted for\nsparse intervals; `Partial` tells consumers that the nearest-rank estimate has fewer\nthan the recommended number of observations.",
      "type": "string",
      "enum": [
        "measured",
        "partial",
        "unavailable"
      ]
    },
    "InstantMetricSample": {
      "description": "One reset-on-publish dashboard telemetry interval. Unlike [`WindowReport`], this\nvalue contains only events observed since the previous publisher cut. Rates are\nnormalized by `interval_duration_ms`, so a delayed tick remains truthful.",
      "type": "object",
      "properties": {
        "accepted_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "accepted_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "active_streams_now": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cancellation_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cancellations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_confidence": {
          "$ref": "#/$defs/TerminalCostConfidence"
        },
        "cost_per_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failure_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "interval_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "latency_overflow_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_relative_error": {
          "type": "number",
          "format": "double"
        },
        "p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p95_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p99_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p99_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "priced_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "quantile_method": {
          "$ref": "#/$defs/QuantileMethod"
        },
        "ready": {
          "type": "boolean"
        },
        "reported_tokens_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "successes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "terminal_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_anomaly_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "interval_duration_ms",
        "ready",
        "accepted_requests",
        "accepted_per_sec",
        "terminal_requests",
        "terminal_per_sec",
        "successes",
        "failures",
        "failure_pct",
        "cancellations",
        "cancellation_pct",
        "active_streams_now",
        "latency_samples",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "p50_quality",
        "p95_quality",
        "p99_quality",
        "quantile_method",
        "max_relative_error",
        "latency_overflow_count",
        "usage_samples",
        "reported_tokens_per_sec",
        "usage_anomaly_count",
        "priced_samples",
        "cost_per_min",
        "cost_confidence"
      ]
    },
    "QuantileMethod": {
      "type": "string",
      "enum": [
        "log_histogram_nearest_rank"
      ]
    },
    "SeqCursors": {
      "description": "The four per-domain cursors carried on the initial [`SnapshotMessage`] — the\n`{flow,metrics,topology,monitor}` sequences the SPA installs as its dedup\nbaseline (`commitSnapshot` in `dashboard-frontend/src/api/ws.ts`). Serializes\nsnake_case to the frozen `SeqCursors` contract.",
      "type": "object",
      "properties": {
        "backend_metrics_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "flow_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metrics_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "monitor_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "topology_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "flow_seq",
        "metrics_seq",
        "topology_seq",
        "monitor_seq",
        "backend_metrics_seq"
      ]
    },
    "TerminalCostConfidence": {
      "description": "Confidence attached to a terminal-time price. This lives with the evict-safe\nterminal payload (rather than the REST projection) so historical overview cuts keep\nthe rate table decision that was true when the request finished.",
      "type": "string",
      "enum": [
        "confident",
        "estimated",
        "unavailable"
      ]
    }
  }
}
