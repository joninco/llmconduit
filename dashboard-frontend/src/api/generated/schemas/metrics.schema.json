{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsSnapshot",
  "description": "The `/api/metrics` snapshot body: the current reset-on-publish interval, optional\nretained request-bearing interval, and `metrics_seq` cursor. Mirrors the frontend\n`MetricsResponse` and the snapshot-time shape of a live metric tick.",
  "type": "object",
  "properties": {
    "engine_throughput": {
      "description": "Preferred stats-bar token source when a fresh physical-engine TPOT interval\nwas observed for the current request generation.",
      "anyOf": [
        {
          "$ref": "#/$defs/EngineThroughputSample"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at_ms": {
      "type": "integer",
      "format": "uint128",
      "minimum": 0
    },
    "instant": {
      "$ref": "#/$defs/InstantMetricSample"
    },
    "last_activity": {
      "description": "Most recent request-bearing interval. Optional for compatibility with\npre-retention snapshots; absent means no request has been observed yet.",
      "anyOf": [
        {
          "$ref": "#/$defs/LastActivitySample"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics_seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "metrics_seq",
    "generated_at_ms",
    "instant"
  ],
  "$defs": {
    "BackendMetricsCoverage": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "EngineThroughputSample": {
      "description": "Physically de-duplicated per-request output-token throughput from the newest\nsuccessful Prometheus TPOT interval across configured engines. The value is the\ninverse mean `request_time_per_output_token_seconds`; speculative accepted tokens\nare already reflected in that shorter output-token time and are never double-counted.\nOne physical `/metrics` endpoint contributes once even when several logical routes\npoint at it.",
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/BackendMetricsCoverage"
        },
        "generated_tokens_per_sec": {
          "type": "number",
          "format": "double"
        },
        "measured_sources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sampled_at_ms": {
          "type": "integer",
          "format": "uint128",
          "minimum": 0
        },
        "total_sources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "generated_tokens_per_sec",
        "sampled_at_ms",
        "measured_sources",
        "total_sources",
        "coverage"
      ]
    },
    "InstantMetricQuality": {
      "description": "Data quality for one instantaneous metric value. Percentiles are still emitted for\nsparse intervals; `Partial` tells consumers that the nearest-rank estimate has fewer\nthan the recommended number of observations.",
      "type": "string",
      "enum": [
        "measured",
        "partial",
        "unavailable"
      ]
    },
    "InstantMetricSample": {
      "description": "One reset-on-publish dashboard telemetry interval. Unlike [`WindowReport`], this\nvalue contains only events observed since the previous publisher cut. Rates are\nnormalized by `interval_duration_ms`, so a delayed tick remains truthful.",
      "type": "object",
      "properties": {
        "accepted_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "accepted_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "active_streams_now": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cancellation_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cancellations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_confidence": {
          "$ref": "#/$defs/TerminalCostConfidence"
        },
        "cost_per_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failure_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "interval_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "latency_overflow_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_relative_error": {
          "type": "number",
          "format": "double"
        },
        "p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p95_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p99_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p99_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "priced_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "quantile_method": {
          "$ref": "#/$defs/QuantileMethod"
        },
        "ready": {
          "type": "boolean"
        },
        "reported_tokens_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "successes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "terminal_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_anomaly_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "interval_duration_ms",
        "ready",
        "accepted_requests",
        "accepted_per_sec",
        "terminal_requests",
        "terminal_per_sec",
        "successes",
        "failures",
        "failure_pct",
        "cancellations",
        "cancellation_pct",
        "active_streams_now",
        "latency_samples",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "p50_quality",
        "p95_quality",
        "p99_quality",
        "quantile_method",
        "max_relative_error",
        "latency_overflow_count",
        "usage_samples",
        "reported_tokens_per_sec",
        "usage_anomaly_count",
        "priced_samples",
        "cost_per_min",
        "cost_confidence"
      ]
    },
    "LastActivitySample": {
      "description": "The most recent reset-on-publish interval that observed a request. Idle cuts\ncarry this alongside their truthful empty [`InstantMetricSample`] so the dashboard\ncan keep the last useful instantaneous figures visible while explicitly aging them.",
      "type": "object",
      "properties": {
        "at_ms": {
          "type": "integer",
          "format": "uint128",
          "minimum": 0
        },
        "instant": {
          "$ref": "#/$defs/InstantMetricSample"
        }
      },
      "required": [
        "at_ms",
        "instant"
      ]
    },
    "QuantileMethod": {
      "type": "string",
      "enum": [
        "log_histogram_nearest_rank"
      ]
    },
    "TerminalCostConfidence": {
      "description": "Confidence attached to a terminal-time price. This lives with the evict-safe\nterminal payload (rather than the REST projection) so historical overview cuts keep\nthe rate table decision that was true when the request finished.",
      "type": "string",
      "enum": [
        "confident",
        "estimated",
        "unavailable"
      ]
    }
  }
}
