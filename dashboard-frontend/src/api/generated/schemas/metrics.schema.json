{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsSnapshot",
  "description": "The full `/api/metrics`-shaped snapshot body (the flat tile + the three\nwindows) PLUS its `metrics_seq` cursor — the snapshot-time analogue of a live\n[`DashboardPayload::MetricTick`]. Mirrors the frontend `MetricsResponse`.",
  "type": "object",
  "properties": {
    "generated_at_ms": {
      "type": "integer",
      "format": "uint128",
      "minimum": 0
    },
    "instant": {
      "$ref": "#/$defs/InstantMetricSample"
    },
    "metrics_seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "metrics_seq",
    "generated_at_ms",
    "instant"
  ],
  "$defs": {
    "InstantMetricQuality": {
      "description": "Data quality for one instantaneous metric value. Percentiles are still emitted for\nsparse intervals; `Partial` tells consumers that the nearest-rank estimate has fewer\nthan the recommended number of observations.",
      "type": "string",
      "enum": [
        "measured",
        "partial",
        "unavailable"
      ]
    },
    "InstantMetricSample": {
      "description": "One reset-on-publish dashboard telemetry interval. Unlike [`WindowReport`], this\nvalue contains only events observed since the previous publisher cut. Rates are\nnormalized by `interval_duration_ms`, so a delayed tick remains truthful.",
      "type": "object",
      "properties": {
        "accepted_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "accepted_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "active_streams_now": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cancellation_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cancellations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_confidence": {
          "$ref": "#/$defs/TerminalCostConfidence"
        },
        "cost_per_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failure_pct": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "interval_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "latency_overflow_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_relative_error": {
          "type": "number",
          "format": "double"
        },
        "p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p50_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p95_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "p99_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p99_quality": {
          "$ref": "#/$defs/InstantMetricQuality"
        },
        "priced_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "quantile_method": {
          "$ref": "#/$defs/QuantileMethod"
        },
        "ready": {
          "type": "boolean"
        },
        "reported_tokens_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "successes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "terminal_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_anomaly_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "interval_duration_ms",
        "ready",
        "accepted_requests",
        "accepted_per_sec",
        "terminal_requests",
        "terminal_per_sec",
        "successes",
        "failures",
        "failure_pct",
        "cancellations",
        "cancellation_pct",
        "active_streams_now",
        "latency_samples",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "p50_quality",
        "p95_quality",
        "p99_quality",
        "quantile_method",
        "max_relative_error",
        "latency_overflow_count",
        "usage_samples",
        "reported_tokens_per_sec",
        "usage_anomaly_count",
        "priced_samples",
        "cost_per_min",
        "cost_confidence"
      ]
    },
    "QuantileMethod": {
      "type": "string",
      "enum": [
        "log_histogram_nearest_rank"
      ]
    },
    "TerminalCostConfidence": {
      "description": "Confidence attached to a terminal-time price. This lives with the evict-safe\nterminal payload (rather than the REST projection) so historical overview cuts keep\nthe rate table decision that was true when the request finished.",
      "type": "string",
      "enum": [
        "confident",
        "estimated",
        "unavailable"
      ]
    }
  }
}
