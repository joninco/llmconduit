{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsSnapshot",
  "description": "The full `/api/metrics`-shaped snapshot body (the flat tile + the three\nwindows) PLUS its `metrics_seq` cursor — the snapshot-time analogue of a live\n[`DashboardPayload::MetricTick`]. Mirrors the frontend `MetricsResponse`.",
  "type": "object",
  "properties": {
    "generated_at_ms": {
      "type": "integer",
      "format": "uint128",
      "minimum": 0
    },
    "headline_window": {
      "$ref": "#/$defs/MetricWindowName"
    },
    "metrics_seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "windows": {
      "$ref": "#/$defs/MetricWindows"
    }
  },
  "required": [
    "metrics_seq",
    "generated_at_ms",
    "headline_window",
    "windows"
  ],
  "$defs": {
    "CostConfidence": {
      "description": "Gap 07 — the CONFIDENCE tier of a flow's `cost`, so an operator can tell a trusted\nfigure from a best-effort estimate from an honest gap. Emitted alongside `cost` on\nevery flow row + detail (and aggregated onto the metrics windows). Serializes\nsnake_case to mirror the data-quality vocabulary the frontend already uses\n(`measured`/`derived`/`estimated`/`unavailable`).",
      "oneOf": [
        {
          "description": "The model is priced AND every billed token class has a known rate: the prompt\n(input) + completion (output) rates always exist when priced, and cached tokens\neither were reported as `0` (nothing billed at the cache rate) OR the model has\na CONFIGURED cached rate. The dollar figure is trustworthy.",
          "type": "string",
          "const": "confident"
        },
        {
          "description": "The model is priced but a billed class would fall back to an APPROXIMATE rate:\ncached tokens were reported `> 0` (or are UNAVAILABLE) while the model has NO\nconfigured cached rate, so those tokens silently bill at the default `0.0`\n(an undercount). The figure is a best-effort ESTIMATE — surfaced as such.",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "No price is configured for the served model: there is NO cost (the row reports\n`cost: null`), so the figure is UNAVAILABLE — never a fabricated `0`. The\nDEFAULT: a window/flow with nothing priced makes no confident claim.",
          "type": "string",
          "const": "unavailable"
        }
      ]
    },
    "MetricQuality": {
      "type": "string",
      "enum": [
        "measured",
        "partial",
        "unavailable"
      ]
    },
    "MetricWindow": {
      "description": "One sliding-window metric tile. Same fields as the headline tile.\n\n`samples` is the count of TERMINAL (finalized) flows that fell in the window —\nthe data-quality signal the frontend uses to tell a genuine measured `0` from an\n`unavailable` gap (gap 01 / \"don't lie with zeros\"). When `samples == 0` the\nlatency/tok-s/cost/error-% fields are NOT measurable (no finalized flow fed them),\nso the strip renders them `—`; `reqs_per_sec` (a genuine `0` for an idle window)\nand `active_streams` (live open-flow count) stay numeric. The field is a finite\n`u64`, so it never violates the frozen finite-number wire contract.",
      "type": "object",
      "properties": {
        "accepted_per_sec": {
          "type": "number",
          "format": "double"
        },
        "accepted_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "active_streams_now": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cancellation_pct": {
          "type": "number",
          "format": "double"
        },
        "cancellations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_confidence": {
          "$ref": "#/$defs/CostConfidence"
        },
        "cost_per_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "failure_pct": {
          "type": "number",
          "format": "double"
        },
        "failures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_overflow_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "latency_quality": {
          "$ref": "#/$defs/MetricQuality"
        },
        "latency_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_relative_error": {
          "type": "number",
          "format": "double"
        },
        "observed_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "p99_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "priced_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "quantile_method": {
          "$ref": "#/$defs/QuantileMethod"
        },
        "reported_tokens_per_sec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "successes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_per_sec": {
          "type": "number",
          "format": "double"
        },
        "terminal_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_anomaly_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "warm": {
          "type": "boolean"
        },
        "window_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "window_seconds",
        "observed_seconds",
        "warm",
        "accepted_requests",
        "accepted_per_sec",
        "terminal_requests",
        "terminal_per_sec",
        "successes",
        "failures",
        "failure_pct",
        "cancellations",
        "cancellation_pct",
        "active_streams_now",
        "latency_samples",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "quantile_method",
        "max_relative_error",
        "latency_overflow_count",
        "latency_quality",
        "usage_samples",
        "reported_tokens_per_sec",
        "usage_anomaly_count",
        "priced_samples",
        "cost_per_min",
        "cost_confidence"
      ]
    },
    "MetricWindowName": {
      "type": "string",
      "enum": [
        "m1"
      ]
    },
    "MetricWindows": {
      "description": "The three sliding windows (`m1`/`m5`/`h1`) of a [`MetricTick`].",
      "type": "object",
      "properties": {
        "h1": {
          "$ref": "#/$defs/MetricWindow"
        },
        "m1": {
          "$ref": "#/$defs/MetricWindow"
        },
        "m5": {
          "$ref": "#/$defs/MetricWindow"
        }
      },
      "required": [
        "m1",
        "m5",
        "h1"
      ]
    },
    "QuantileMethod": {
      "type": "string",
      "enum": [
        "log_histogram_nearest_rank"
      ]
    }
  }
}
